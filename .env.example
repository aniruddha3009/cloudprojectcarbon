# Copy this file to ".env" in the SAME folder (the project root) and fill in values.
# start-dev.ps1 does the copy for you the first time. Never commit the real .env file.

# development | production
ENVIRONMENT=development
# SQLite by default (files are created automatically in backend/data).
# DATABASE_URL=sqlite:///./backend/data/carbon_debt.db
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for any public deployment: mutating API calls need header X-Admin-Token.
ADMIN_TOKEN=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Live mode
# India Energy Atlas API key (https://www.energymap.in/settings#api-keys). Looks like iea_live_...
# Put the value after the = sign, with no quotes and no spaces. Restart the backend afterwards.
INDIA_ENERGY_ATLAS_API_KEY=
# Optional state slug. Leave EMPTY for the all-India figure: state-level data needs a paid or
# institutional plan, and free Sandbox/Student keys return "402 feature_not_in_plan" for it.
INDIA_ENERGY_ATLAS_STATE=
# Free keys allow 100 calls/day: poll every 20 minutes (72/day) + a forecast every 3 hours (8/day).
INDIA_ENERGY_ATLAS_POLL_MINUTES=20
INDIA_ENERGY_ATLAS_FORECAST_HOURS=3

# Live accounting slot (seconds) and how hard each managed demo job may use one CPU core (0–0.8).
LIVE_SLOT_SECONDS=30
LIVE_JOB_DUTY=0.35
# Only used if this PC has no energy meter: watts per fully busy core for the labelled estimate.
LIVE_CORE_WATTS=12
PROCESS_POLL_SECONDS=2.5

# --------------------------------------------------------- Simulation mode
# Real CPU proxy kernel per simulated job-slot (milliseconds, 0 disables).
KERNEL_MS=20

# Cloud VM deployment only (deploy/docker-compose.cloud.yml)
DOMAIN=
